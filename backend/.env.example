# Copiar a .env y ajustar. docker-compose.yml también lee estas variables.
PORT=3000
# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5433
DB_NAME=drh_sistema
DB_USER=drh
DB_PASSWORD=drh_dev
# Solo desarrollo: crea/actualiza las tablas a partir de las entidades.
# Antes de pasar a producción se reemplaza por migraciones.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Carpeta donde se guardan los archivos subidos (KML originales…). Va a backups, no a git.
STORAGE_DIR=./storage

# Correo (avisos a los titulares, ej: deuda). Sin SMTP_HOST los correos se registran en
# not_email como «modo prueba» y no se envían.
# SMTP_HOST=smtp.ejemplo.gob.ar
# SMTP_PUERTO=587
# SMTP_SEGURO=false
# SMTP_USUARIO=
# SMTP_CLAVE=
# SMTP_REMITENTE=DRH - Sistema de Concesiones <no-responder@ejemplo.gob.ar>

# --- Login y permisos ---
# Horas sin uso hasta que vence la sesión (por defecto 8).
# SESION_HORAS=8
# Crea el usuario ADMIN (administrador) la primera vez que arranca; al entrar cambia la contraseña.
# ADMIN_CLAVE_INICIAL=
# SOLO DESARROLLO (se ignoran con NODE_ENV=production):
#   contraseña de los usuarios de prueba DEMO-* (uno por oficina, rol Jefe)
# CLAVE_USUARIOS_PRUEBA=
#   aceptar el encabezado X-Usuario-Id sin login (tests e2e y scripts de requests/)
# AUTH_ENCABEZADO_PRUEBAS=false
