{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migracion": "tsc -p tsconfig.build.json --outDir dist-cli && node dist-cli/migracion/cli.js",
    "demo:generar": "node scripts/demo/generar-padron-demo.mjs",
    "demo:cargar": "npm run demo:generar && npm run migracion -- importar datos/demo/padron-demo.json --demo",
    "demo:borrar": "npm run migracion -- borrar-demo",
    "sig:cauces": "npm run migracion -- cargar-cauces recursos/sig/cauces-osm.json",
    "db:tablas": "node --env-file-if-exists=.env scripts/db/documentar-tablas.mjs",
    "db:sql": "docker exec drh-postgres pg_dump -U drh -d drh_sistema --schema-only --no-owner --schema=public --schema=sig -f /tmp/esquema.sql && docker cp drh-postgres:/tmp/esquema.sql docs/esquema.sql"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "@tmcw/togeojson": "^7.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
